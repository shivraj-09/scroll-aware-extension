{
  "manifest_version": 3,
  "name": "ScrollAware",
  "description": "Detects continuous scrolling on social media and nudges users to take mindful breaks.",
  "version": "0.1.0",

  "icons": {
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
  {
    "matches": [
      "https://www.instagram.com/*",
      "https://www.tiktok.com/*"
    ],
    "run_at": "document_idle",
    "js": [
      "content/detection.js",
      "content/discipline.js",
      "content/hud.js",
      "content/storage.js",
      "content/overlay.js",
      "content/timer.js",
      "content.js"
    ]
  }
]
}
